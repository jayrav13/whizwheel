#!/usr/bin/env ruby
# frozen_string_literal: true

# build-agents-site — generate the "Agents of whizwheel" GitHub Pages site
# FROM the agent definitions, so the published site cannot drift from the
# source of truth (.claude/agents/*.md).
#
# Why a standalone Ruby script (not a Rails rake task):
#   - It must run in the Pages deploy workflow without booting Rails, a DB,
#     or installing Node — consistent with whizwheel's no-Node-build norm
#     (CLAUDE.md → "Running things"). Pure stdlib, no gems.
#
# What it does:
#   1. Reads every .claude/agents/*.md (YAML-ish front-matter + markdown body).
#   2. Derives a structured surface per agent (name, model, tools, one-line
#      purpose, writes-via-PR vs report-only) and renders the full body.
#   3. Emits a self-contained static site into the build dir (default: _site/),
#      with an index (roster + orchestration overview) and one page per agent.
#
# The site is DERIVED, not hand-maintained: rerun this and the site is current.
#
# Usage:
#   bin/build-agents-site [OUTPUT_DIR]      # default OUTPUT_DIR = _site
#   AGENTS_DIR=path bin/build-agents-site   # override source dir (tests)

require "cgi"
require "fileutils"
require "time"

# --------------------------------------------------------------------------
# Paths
# --------------------------------------------------------------------------
REPO_ROOT  = File.expand_path("..", __dir__)
AGENTS_DIR = ENV.fetch("AGENTS_DIR", File.join(REPO_ROOT, ".claude", "agents"))
OUTPUT_DIR = ARGV[0] || File.join(REPO_ROOT, "_site")

# --------------------------------------------------------------------------
# Front-matter + body parsing
# --------------------------------------------------------------------------
# Agent defs open with a `---` fenced YAML block. We only need flat
# scalar keys (name, color, description, tools, model), so a tiny
# line-based parser is enough — no YAML gem required.
def parse_agent(path)
  raw = File.read(path)
  unless raw.start_with?("---")
    return { meta: {}, body: raw.strip, slug: File.basename(path, ".md") }
  end

  # Split off the first front-matter block.
  _, fm, body = raw.split(/^---\s*$\n/, 3)
  meta = {}
  current_key = nil
  fm.to_s.each_line do |raw_line|
    line = raw_line.chomp
    if (m = line.match(/\A([A-Za-z0-9_]+):\s*(.*)\z/))
      current_key = m[1]
      meta[current_key] = m[2].strip
    elsif current_key && line =~ /\A\s+\S/
      # folded continuation line — append.
      meta[current_key] = "#{meta[current_key]} #{line.strip}".strip
    end
  end

  {
    meta: meta,
    body: body.to_s.strip,
    slug: File.basename(path, ".md")
  }
end

# Derived facts the index/cards display, inferred from the front-matter so
# they stay in lockstep with the definition.
def derive(agent)
  meta  = agent[:meta]
  tools = (meta["tools"] || "").split(",").map(&:strip).reject(&:empty?)
  desc  = meta["description"].to_s

  # A writing agent has Write or Edit in its toolset; everything else is
  # report-only. We corroborate with the prose ("report-only") for clarity.
  can_write   = tools.any? { |t| %w[Write Edit].include?(t) }
  says_report = desc =~ /report-only/i
  role = if can_write && !says_report
           "writes — worktree → PR"
  else
           "report-only"
  end

  # One-line purpose: first sentence of the description.
  purpose = desc.split(/(?<=[.!?])\s+/).first.to_s.strip

  {
    name:    meta["name"] || agent[:slug],
    slug:    agent[:slug],
    model:   (meta["model"] || "—").capitalize,
    color:   meta["color"],
    tools:   tools,
    role:    role,
    purpose: purpose,
    description: desc
  }
end

# --------------------------------------------------------------------------
# Minimal Markdown -> HTML
# --------------------------------------------------------------------------
# Covers the constructs the agent defs actually use: ATX headings, fenced
# code blocks, unordered/ordered lists (with nesting), blockquotes, hr,
# paragraphs, and inline bold / italic / code / links. Deliberately small;
# adding a markdown gem would mean adding a dependency to the Pages build.
module Markdown
  module_function

  def render(text)
    lines = text.gsub("\r\n", "\n").split("\n", -1)
    html = +""
    i = 0
    while i < lines.length
      line = lines[i]

      # Fenced code block.
      if line =~ /\A\s*```/
        fence = line.strip
        lang  = fence.sub(/\A`+/, "").strip
        buf = []
        i += 1
        i += 1 while i < lines.length && lines[i] !~ /\A\s*```/ && (buf << lines[i])
        i += 1 # skip closing fence
        cls = lang.empty? ? "" : %( class="language-#{CGI.escapeHTML(lang)}")
        html << %(<pre><code#{cls}>#{CGI.escapeHTML(buf.join("\n"))}\n</code></pre>\n)
        next
      end

      # Horizontal rule.
      if line =~ /\A\s*(---|\*\*\*|___)\s*\z/
        html << "<hr>\n"
        i += 1
        next
      end

      # ATX heading.
      if (m = line.match(/\A(\#{1,6})\s+(.*)\z/))
        level = m[1].length
        html << "<h#{level}>#{inline(m[2].strip)}</h#{level}>\n"
        i += 1
        next
      end

      # Blockquote (consume consecutive > lines).
      if line =~ /\A\s*>/
        buf = []
        while i < lines.length && lines[i] =~ /\A\s*>/
          buf << lines[i].sub(/\A\s*>\s?/, "")
          i += 1
        end
        html << "<blockquote>\n#{render(buf.join("\n"))}</blockquote>\n"
        next
      end

      # List (ordered or unordered) with one level of nesting by indent.
      if line =~ /\A\s*([-*+]|\d+\.)\s+/
        block, i = collect_list_block(lines, i)
        html << render_list(block)
        next
      end

      # Blank line.
      if line.strip.empty?
        i += 1
        next
      end

      # Paragraph: gather until blank / block starter.
      buf = []
      while i < lines.length &&
            !lines[i].strip.empty? &&
            lines[i] !~ /\A\s*(\#{1,6}\s|```|>|([-*+]|\d+\.)\s|(---|\*\*\*|___)\s*\z)/
        buf << lines[i]
        i += 1
      end
      html << "<p>#{inline(buf.join(" ").strip)}</p>\n"
    end
    html
  end

  # Pull a contiguous list block out of the line stream. A list block runs
  # until a blank line that is NOT followed by an indented continuation,
  # or a non-indented line that is not itself a list item.
  def collect_list_block(lines, i)
    block = []
    while i < lines.length
      l = lines[i]
      if l.strip.empty?
        break if i + 1 >= lines.length || lines[i + 1] !~ /\A\s+\S/
        i += 1
        next
      end
      # A non-list, non-indented line ends the block (back to a paragraph).
      break if l !~ /\A\s*([-*+]|\d+\.)\s+/ && l !~ /\A\s+\S/
      block << l
      i += 1
    end
    [ block, i ]
  end

  # A list item. `content` is the marker line's text; `cont` holds raw
  # continuation lines (for fenced blocks etc.); `indent` is the marker column.
  Item = Struct.new(:content, :cont, :indent, :children, :ordered, :fenced)

  # Build a nested item tree from the raw list lines. Lines that start with a
  # list marker open a new item at their indent; lines that are merely indented
  # (no marker) are CONTINUATIONS of the current item — they are attached to
  # it, NOT treated as nested items. Continuation lines are joined into the
  # item text, EXCEPT when the item contains a fenced code block, in which case
  # the whole item body is rendered block-level so the fence survives intact.
  def build_items(block)
    items = []
    in_fence = false
    block.each do |line|
      indent = line[/\A\s*/].length
      starts_item = !in_fence && line =~ /\A\s*([-*+]|\d+\.)\s+/
      if starts_item
        ordered = !line[/\A\s*(\d+)\.\s/].nil?
        items << Item.new(line.sub(/\A\s*([-*+]|\d+\.)\s+/, "").rstrip, [], indent, [], ordered, false)
      elsif !items.empty?
        items.last.cont << line
        if line.strip.start_with?("```")
          in_fence = !in_fence
          items.last.fenced = true
        end
      end
    end
    nest(items)
  end

  # Fold a flat, indent-tagged item list into a tree by indentation.
  def nest(items)
    roots = []
    stack = []
    items.each do |it|
      it.children = []
      pop_to(stack, it.indent)
      if stack.empty?
        roots << it
      else
        stack.last.children << it
      end
      stack << it
    end
    roots
  end

  def pop_to(stack, indent)
    stack.pop while !stack.empty? && stack.last.indent >= indent
  end

  def render_list(block)
    render_items(build_items(block))
  end

  def render_items(items)
    return "" if items.empty?

    tag = items.first.ordered ? "ol" : "ul"
    out = +"<#{tag}>\n"
    items.each do |it|
      out << "<li>"
      if it.fenced
        # Render the marker line + continuation block-level so the fenced
        # code block (and any prose around it) renders correctly. Strip the
        # common leading indent off continuation lines so fenced content is
        # not artificially indented.
        strip = it.cont.reject { |l| l.strip.empty? }
                       .map { |l| l[/\A */].length }.min || 0
        body = ([ it.content ] + it.cont.map { |l| l.sub(/\A {0,#{strip}}/, "") }).join("\n")
        out << "\n#{render(body)}"
      else
        joined = ([ it.content ] + it.cont.map(&:strip).reject(&:empty?)).join(" ").strip
        out << inline(joined)
      end
      out << "\n#{render_items(it.children)}" unless it.children.empty?
      out << "</li>\n"
    end
    out << "</#{tag}>\n"
    out
  end

  # Inline spans. Order matters: protect code spans first.
  def inline(text)
    placeholders = []
    # Inline code.
    text = text.gsub(/`([^`]+)`/) do
      placeholders << "<code>#{CGI.escapeHTML(Regexp.last_match(1))}</code>"
      "␀#{placeholders.length - 1}␀"
    end
    # Escape everything else.
    text = CGI.escapeHTML(text)
    # Links [text](url).
    text = text.gsub(/\[([^\]]+)\]\(([^)]+)\)/) do
      label = Regexp.last_match(1)
      href  = Regexp.last_match(2)
      %(<a href="#{href}">#{label}</a>)
    end
    # Bold (non-greedy so it may contain nested italic), then italic.
    text = text.gsub(/\*\*(.+?)\*\*/m, '<strong>\1</strong>')
    text = text.gsub(/(?<!\*)\*(?!\*)([^*\n]+?)\*(?!\*)/, '<em>\1</em>')
    # Restore code spans.
    text.gsub(/␀(\d+)␀/) { placeholders[Regexp.last_match(1).to_i] }
  end
end

# --------------------------------------------------------------------------
# HTML chrome (hand-authored shell; agent CONTENT is always regenerated)
# --------------------------------------------------------------------------
