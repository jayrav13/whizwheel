def layout(title:, crumb:, body:)
  <<~HTML
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>#{CGI.escapeHTML(title)}</title>
      <meta name="description" content="The agents of whizwheel — an experiment in agent-driven development. Auto-generated from .claude/agents/*.md.">
      <style>#{STYLES}</style>
    </head>
    <body>
      <header class="site">
        <div class="wrap">
          <div class="crumb">#{crumb}</div>
          <h1>#{CGI.escapeHTML(title)}</h1>
          <p>The roster of agents that build <strong>whizwheel</strong> — an experiment in agent-driven development.</p>
        </div>
      </header>
      <main>
        <div class="wrap">
          #{body}
        </div>
      </main>
      <footer class="site">
        <div class="wrap">
          Generated from <code>.claude/agents/*.md</code> by <code>bin/build-agents-site</code> on #{Time.now.utc.strftime("%Y-%m-%d")} (UTC).
          The site is <strong>derived from the definitions</strong>, so it cannot drift from them.
        </div>
      </footer>
    </body>
    </html>
  HTML
end

def role_badge(role)
  if role.start_with?("writes")
    %(<span class="badge writes">writes &middot; worktree &rarr; PR</span>)
  else
    %(<span class="badge report">report-only</span>)
  end
end

ORCHESTRATION_FLOW = <<~FLOW
     ┌─────────────┐
     │ main thread │  orchestrator — stays ahead of the airplane
     └──────┬──────┘
            │ dispatches (default: in the background)
            ▼
   ┌────────────────────────────────────────────┐
   │   build / write agents      report-only     │
   │   backend  frontend         ci-monitor      │
   │   project-manager-agent     dependabot-agent│
   │   historian  database-agent                 │
   └───────┬─────────────────────────┬──────────┘
           │ each creates its own     │ never write;
           │ worktree, opens a PR     │ just report
           ▼                          │
        ┌──────┐   ci-monitor watches │
        │  PR  │◀─────────────────────┘
        └───┬──┘   + visual gate (screenshots)
            │
            ▼
     ┌────────────┐
     │ human merge│  never auto-merged
     └────────────┘
FLOW

# --------------------------------------------------------------------------
# Page builders
# --------------------------------------------------------------------------
def index_page(agents)
  cards = agents.map do |a|
    badges = [
      %(<span class="badge model">#{CGI.escapeHTML(a[:model])}</span>),
      role_badge(a[:role])
    ].join
    <<~CARD
      <a class="card" href="#{a[:slug]}.html">
        <div class="name">#{CGI.escapeHTML(a[:name])}</div>
        <div class="purpose">#{CGI.escapeHTML(a[:purpose])}</div>
        <div class="badges">#{badges}</div>
      </a>
    CARD
  end.join("\n")

  body = <<~BODY
    <p>
      whizwheel is built by <strong>iterating on agent definitions</strong>, not by hand-editing code.
      Each agent below has one job, a fixed scope, and clear boundaries. This page is generated
      directly from <code>.claude/agents/*.md</code> — the source of truth — so it is always current.
    </p>

    <div class="lockstep">
      <strong>Lockstep by construction.</strong> This site is <em>derived</em> from the agent
      definitions at deploy time. Change a definition and the published page changes with it; there
      is nothing to hand-sync, so it cannot drift.
    </div>

    <h2>The roster</h2>
    <div class="grid">
      #{cards}
    </div>

    <h2>How the agents fit together</h2>
    <p>
      The <strong>main thread</strong> is an orchestrator: it catches unblocked work and dispatches it
      to specialized agents — by default <em>in the background</em>, so it never sits idle. Writing
      agents each work in their own <strong>git worktree</strong> and land changes through a
      <strong>pull request</strong>; report-only agents never write. Every PR is watched by
      <code>ci-monitor</code> and cleared through a <strong>visual gate</strong> before a
      <strong>human</strong> merges it — nothing is auto-merged.
    </p>
    <pre class="flow">#{CGI.escapeHTML(ORCHESTRATION_FLOW)}</pre>

    <h3>The two lanes</h3>
    <ul>
      <li><strong>Writing agents</strong> — create a worktree, commit, push, and open a PR; they never merge and never push to <code>main</code>.</li>
      <li><strong>Report-only agents</strong> — observe and report (CI status, dependency triage); they never edit, merge, or file changes.</li>
    </ul>
  BODY

  layout(
    title: "Agents of whizwheel",
    crumb: "whizwheel &middot; agent-driven development",
    body: body
  )
end

def agent_page(a, body_html)
  tools = a[:tools].empty? ? "—" : a[:tools].map { |t| "<code>#{CGI.escapeHTML(t)}</code>" }.join(", ")
  meta = <<~META
    <table class="meta-table">
      <tr><th>Name</th><td><code>#{CGI.escapeHTML(a[:name])}</code></td></tr>
      <tr><th>Model</th><td>#{CGI.escapeHTML(a[:model])}</td></tr>
      <tr><th>Role</th><td>#{role_badge(a[:role])}</td></tr>
      <tr><th>Tools</th><td>#{tools}</td></tr>
      <tr><th>Purpose</th><td>#{CGI.escapeHTML(a[:purpose])}</td></tr>
    </table>
  META

  body = <<~BODY
    <p class="backlink"><a href="index.html">&larr; All agents</a></p>
    <h2>#{CGI.escapeHTML(a[:name])}</h2>
    <p>#{CGI.escapeHTML(a[:description])}</p>
    #{meta}
    <h4>Full definition</h4>
    <div class="agent-body">#{body_html}</div>
  BODY

  layout(
    title: "#{a[:name]} — Agents of whizwheel",
    crumb: %(<a href="index.html">Agents</a> &middot; #{CGI.escapeHTML(a[:name])}),
    body: body
  )
end

# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------
def main
  paths = Dir.glob(File.join(AGENTS_DIR, "*.md")).sort
  abort "No agent definitions found in #{AGENTS_DIR}" if paths.empty?

  parsed = paths.map { |p| [ parse_agent(p), p ] }
  agents = parsed.map { |agent, _| derive(agent) }

  FileUtils.mkdir_p(OUTPUT_DIR)
  # .nojekyll: tell GitHub Pages to serve our files as-is (no Jekyll pass).
  File.write(File.join(OUTPUT_DIR, ".nojekyll"), "")

  File.write(File.join(OUTPUT_DIR, "index.html"), index_page(agents))

  parsed.each_with_index do |(agent, _path), idx|
    a = agents[idx]
    body_html = Markdown.render(agent[:body])
    File.write(File.join(OUTPUT_DIR, "#{a[:slug]}.html"), agent_page(a, body_html))
  end

  puts "Built #{agents.length} agent page(s) + index into #{OUTPUT_DIR}"
  agents.each { |a| puts "  - #{a[:name]} (#{a[:model]}, #{a[:role]})" }
end

main if $PROGRAM_NAME == __FILE__
