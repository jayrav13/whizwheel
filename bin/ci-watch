#!/usr/bin/env bash
# ci-watch — report GitHub Actions CI status for a commit, branch, or PR.
#
# Exit codes: 0 = all checks passed | 1 = failed | 2 = still pending | 3 = no run / error
#
# Usage:
#   bin/ci-watch                 # latest run on the current branch
#   bin/ci-watch <branch>        # latest run on <branch>
#   bin/ci-watch --pr <number>   # latest run for a PR's head branch
#   bin/ci-watch --sha <sha>     # run for a specific commit (short or full SHA)
#   bin/ci-watch ... --poll      # block until the run completes (else single check)
#   bin/ci-watch ... --logs      # on failure, also print failed-job logs

set -uo pipefail

# Expand a possibly-abbreviated SHA to its full 40-char form. A short SHA never
# matches a run's full headSha, so resolving it first is what prevents a false
# NO-RUN (#224). Try the local git object, then the GitHub API (for commits not
# present locally — e.g. a PR head on a fetch-less checkout). Echoes the input
# unchanged if it cannot be expanded.
expand_sha() {
  local s="$1" full
  [[ -n "$s" ]] || return 1
  if [[ "$s" =~ ^[0-9a-fA-F]{40}$ ]]; then echo "$s"; return 0; fi
  if full=$(git rev-parse --verify --quiet "${s}^{commit}" 2>/dev/null) && [[ -n "$full" ]]; then
    echo "$full"; return 0
  fi
  if full=$(gh api "repos/{owner}/{repo}/commits/${s}" --jq '.sha' 2>/dev/null) && [[ -n "$full" && "$full" != "null" ]]; then
    echo "$full"; return 0
  fi
  echo "$s"
}

# Resolve a CI run id for a full SHA via the server-side --commit filter — no
# manual headSha equality (which an abbreviated SHA silently fails) and no
# --limit window that could miss an older-but-real run (#224).
run_id_for_sha() {
  gh run list --commit "$1" --limit 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null
}

poll=false; logs=false; ref=""; mode="branch"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --poll) poll=true; shift ;;
    --logs) logs=true; shift ;;
    --pr)   mode="pr";  ref="${2:-}"; shift 2 ;;
    --sha)  mode="sha"; ref="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) ref="$1"; shift ;;
  esac
done

branch=""; sha=""
case "$mode" in
  pr)
    branch=$(gh pr view "$ref" --json headRefName --jq .headRefName 2>/dev/null) \
      || { echo "ci-watch: PR $ref not found" >&2; exit 3; }
    sha=$(gh pr view "$ref" --json headRefOid --jq .headRefOid 2>/dev/null) ;;
  sha) sha="$ref" ;;
  branch) branch="${ref:-$(git rev-parse --abbrev-ref HEAD)}" ;;
esac

if [[ -n "$sha" ]]; then
  sha=$(expand_sha "$sha")
  run_id=$(run_id_for_sha "$sha")
else
  run_id=$(gh run list --branch "$branch" --limit 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null)
fi

if [[ -z "$run_id" || "$run_id" == "null" ]]; then
  echo "ci-watch: no CI run found for ${ref:-current branch}" >&2; exit 3
fi

$poll && gh run watch "$run_id" --exit-status --interval 15 >/dev/null 2>&1

read -r status conclusion url < <(gh run view "$run_id" --json status,conclusion,url \
  --jq '"\(.status) \(.conclusion) \(.url)"')
jobs=$(gh run view "$run_id" --json jobs --jq '[.jobs[] | "\(.name)=\(.conclusion // .status)"] | join(", ")')

if [[ "$status" != "completed" ]]; then
  echo "PENDING  run $run_id ($status)  $url"; echo "jobs: $jobs"; exit 2
elif [[ "$conclusion" == "success" ]]; then
  echo "PASS     run $run_id  $url"; echo "jobs: $jobs"; exit 0
else
  echo "FAIL     run $run_id ($conclusion)  $url"; echo "jobs: $jobs"
  if $logs; then
    echo "----- failed-job logs -----"
    gh run view "$run_id" --log-failed 2>/dev/null | grep -viE 'collation|WARNING|DETAIL|HINT' | tail -60
  fi
  exit 1
fi
