#!/usr/bin/env bash
# ci-watch — report GitHub Actions CI status for a commit, branch, or PR.
#
# Exit codes: 0 = all checks passed | 1 = failed | 2 = still pending | 3 = no run / error
#
# Usage:
#   bin/ci-watch                 # latest run on the current branch
#   bin/ci-watch <branch>        # latest run on <branch>
#   bin/ci-watch --pr <number>   # latest run for a PR's head branch
#   bin/ci-watch --sha <sha>     # run for a specific commit (short or full SHA)
#   bin/ci-watch ... --poll      # block until the run completes (else single check)
#   bin/ci-watch ... --logs      # on failure, also print failed-job logs

set -uo pipefail

# Expand a possibly-abbreviated SHA to its full 40-char form. A short SHA never
# matches a run's full headSha, so resolving it first is what prevents a false
# NO-RUN (#224). Try the local git object, then the GitHub API (for commits not
# present locally — e.g. a PR head on a fetch-less checkout). Echoes the input
# unchanged if it cannot be expanded.
expand_sha() {
  local s="$1" full
  [[ -n "$s" ]] || return 1
  if [[ "$s" =~ ^[0-9a-fA-F]{40}$ ]]; then echo "$s"; return 0; fi
  if full=$(git rev-parse --verify --quiet "${s}^{commit}" 2>/dev/null) && [[ -n "$full" ]]; then
    echo "$full"; return 0
  fi
  if full=$(gh api "repos/{owner}/{repo}/commits/${s}" --jq '.sha' 2>/dev/null) && [[ -n "$full" && "$full" != "null" ]]; then
    echo "$full"; return 0
  fi
  echo "$s"
}

# Resolve a run id for a full SHA. The server-side --commit filter is primary
# (no headSha equality an abbreviated SHA silently fails, no --limit window that
# could miss an older-but-real run, #224). But --commit is eventually consistent:
# right after a run is created it can index slower than `gh run view` of a known
# run, returning [] for a run that is demonstrably live/green (#261). So when
# --commit comes back empty, fall back to a client-side headSha scan over a wide
# recent window — `gh run view` can see runs the --commit filter hasn't indexed.
run_id_for_sha() {
  local sha="$1" id
  id=$(gh run list --commit "$sha" --limit 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null)
  [[ -n "$id" && "$id" != "null" ]] && { echo "$id"; return 0; }
  gh run list --limit 100 --json databaseId,headSha \
    --jq "[.[] | select(.headSha==\"$sha\")][0].databaseId // empty" 2>/dev/null
}

# Resolve a run id for a PR. `gh pr checks` reads the PR's actual check-run
# association (not a SHA/branch filter), so it finds the run even when --commit
# hasn't indexed and the --branch filter can't reach a pull_request-event run
# (#261). Its `link` field embeds the run id: .../actions/runs/<id>/job/<jid>.
# Fall back to --commit on the head SHA, then to the --branch filter.
run_id_for_pr() {
  local ref="$1" head_sha="$2" branch="$3" id
  id=$(gh pr checks "$ref" --json link --jq '.[0].link' 2>/dev/null \
    | grep -oE 'runs/[0-9]+' | head -1 | grep -oE '[0-9]+')
  [[ -n "$id" ]] && { echo "$id"; return 0; }
  if [[ -n "$head_sha" ]]; then
    id=$(run_id_for_sha "$head_sha")
    [[ -n "$id" ]] && { echo "$id"; return 0; }
  fi
  [[ -n "$branch" ]] || return 1
  gh run list --branch "$branch" --limit 1 --json databaseId --jq '.[0].databaseId // empty' 2>/dev/null
}

# Resolve a run id with a bounded retry. The run may be created moments after the
# push but before any index catches up, so a single shot can false-NO-RUN a run
# that is about to be (or already is) live (#261). Retry the given resolver a few
# times before giving up. Prints the run id on success, nothing on exhaustion.
resolve_with_retry() {
  local id attempt
  for attempt in 1 2 3 4 5; do
    id=$("$@")
    [[ -n "$id" && "$id" != "null" ]] && { echo "$id"; return 0; }
    [[ $attempt -lt 5 ]] && sleep 3
  done
  return 1
}

poll=false; logs=false; ref=""; mode="branch"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --poll) poll=true; shift ;;
    --logs) logs=true; shift ;;
    --pr)   mode="pr";  ref="${2:-}"; shift 2 ;;
    --sha)  mode="sha"; ref="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) ref="$1"; shift ;;
  esac
done

run_id=""
case "$mode" in
  pr)
    branch=$(gh pr view "$ref" --json headRefName --jq .headRefName 2>/dev/null) \
      || { echo "ci-watch: PR $ref not found" >&2; exit 3; }
    head_sha=$(gh pr view "$ref" --json headRefOid --jq .headRefOid 2>/dev/null)
    [[ -n "$head_sha" ]] && head_sha=$(expand_sha "$head_sha")
    run_id=$(resolve_with_retry run_id_for_pr "$ref" "$head_sha" "$branch") ;;
  sha)
    sha=$(expand_sha "$ref")
    run_id=$(resolve_with_retry run_id_for_sha "$sha") ;;
  branch)
    branch="${ref:-$(git rev-parse --abbrev-ref HEAD)}"
    run_id=$(resolve_with_retry \
      gh run list --branch "$branch" --limit 1 --json databaseId --jq '.[0].databaseId // empty') ;;
esac

if [[ -z "$run_id" || "$run_id" == "null" ]]; then
  echo "ci-watch: no CI run found for ${ref:-current branch}" >&2; exit 3
fi

$poll && gh run watch "$run_id" --exit-status --interval 15 >/dev/null 2>&1

read -r status conclusion url < <(gh run view "$run_id" --json status,conclusion,url \
  --jq '"\(.status) \(.conclusion) \(.url)"')
jobs=$(gh run view "$run_id" --json jobs --jq '[.jobs[] | "\(.name)=\(.conclusion // .status)"] | join(", ")')

if [[ "$status" != "completed" ]]; then
  echo "PENDING  run $run_id ($status)  $url"; echo "jobs: $jobs"; exit 2
elif [[ "$conclusion" == "success" ]]; then
  echo "PASS     run $run_id  $url"; echo "jobs: $jobs"; exit 0
else
  echo "FAIL     run $run_id ($conclusion)  $url"; echo "jobs: $jobs"
  if $logs; then
    echo "----- failed-job logs -----"
    gh run view "$run_id" --log-failed 2>/dev/null | grep -viE 'collation|WARNING|DETAIL|HINT' | tail -60
  fi
  exit 1
fi
