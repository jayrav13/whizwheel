<% if current_user %>
  <section class="rounded-[18px] border border-border bg-surface p-8 shadow-[0_10px_34px_rgba(150,110,80,0.12)]">
    <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent">Welcome back</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-[-0.035em] text-ink">
      Signed in as <%= current_user.username %>
    </h1>
    <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-muted">
      Your calculations are attributed to your account, so your history and usage stats stay with you.
    </p>
    <div class="mt-6">
      <%= button_to "Sign out", session_path, method: :delete, class: "rounded-[13px] border border-border-input px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-primary hover:text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" %>
    </div>
  </section>
<% else %>
  <section class="rounded-[18px] border border-border bg-surface p-8 shadow-[0_10px_34px_rgba(150,110,80,0.12)] sm:p-12">
    <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent">A calculator library, sharpened</p>
    <h1 class="mt-3 max-w-2xl text-4xl font-extrabold leading-[1.05] tracking-[-0.035em] text-ink sm:text-5xl">
      Every answer, computed server-side and verifiable to the decimal.
    </h1>
    <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-muted">
      A reimagining of calculator.net — a broad, warm, fast library of calculators.
      Anyone can use any calculator, no login required. You are not signed in; sign in to
      keep a personal history of your calculations and your usage stats.
    </p>
    <div class="mt-8">
      <%= link_to "Sign in", new_session_path, class: "inline-block rounded-[13px] bg-primary px-5 py-2.5 text-sm font-semibold text-surface shadow-sm transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" %>
    </div>
  </section>
<% end %>

<%# The catalog teaser — the calculators built so far link out from here. As the
    library grows this becomes the index; today it surfaces the first one. %>
<section class="mt-8">
  <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent">Calculators</p>
  <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <%= link_to "/calculators/percentage",
          class: "group rounded-[18px] border border-border bg-surface p-6 shadow-[0_10px_34px_rgba(150,110,80,0.12)] transition-colors hover:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" do %>
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-faint">Math</p>
      <h2 class="mt-2 text-lg font-extrabold tracking-[-0.02em] text-ink group-hover:text-primary">Percentage</h2>
      <p class="mt-1.5 text-[15px] leading-relaxed text-muted">
        Five percentage operations — % of a number, what percent, percent of what, difference, and increase/decrease.
      </p>
    <% end %>
    <%= link_to "/calculators/ohms_law",
          class: "group rounded-[18px] border border-border bg-surface p-6 shadow-[0_10px_34px_rgba(150,110,80,0.12)] transition-colors hover:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" do %>
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-faint">Physics</p>
      <h2 class="mt-2 text-lg font-extrabold tracking-[-0.02em] text-ink group-hover:text-primary">Ohm's Law</h2>
      <p class="mt-1.5 text-[15px] leading-relaxed text-muted">
        Voltage, current, resistance, and power — supply any two and solve the other two.
      </p>
    <% end %>
    <%= link_to "/calculators/bmi",
          class: "group rounded-[18px] border border-border bg-surface p-6 shadow-[0_10px_34px_rgba(150,110,80,0.12)] transition-colors hover:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" do %>
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-faint">Fitness &amp; Health</p>
      <h2 class="mt-2 text-lg font-extrabold tracking-[-0.02em] text-ink group-hover:text-primary">BMI</h2>
      <p class="mt-1.5 text-[15px] leading-relaxed text-muted">
        Body Mass Index from weight and height, in US or metric units, with the WHO classification band.
      </p>
    <% end %>
    <%= link_to "/calculators/age",
          class: "group rounded-[18px] border border-border bg-surface p-6 shadow-[0_10px_34px_rgba(150,110,80,0.12)] transition-colors hover:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" do %>
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-faint">Other</p>
      <h2 class="mt-2 text-lg font-extrabold tracking-[-0.02em] text-ink group-hover:text-primary">Age</h2>
      <p class="mt-1.5 text-[15px] leading-relaxed text-muted">
        Your exact age between two dates — years, months and days, plus total months, weeks, days and hours.
      </p>
    <% end %>
    <%= link_to "/calculators/simple_interest",
          class: "group rounded-[18px] border border-border bg-surface p-6 shadow-[0_10px_34px_rgba(150,110,80,0.12)] transition-colors hover:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" do %>
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-faint">Financial</p>
      <h2 class="mt-2 text-lg font-extrabold tracking-[-0.02em] text-ink group-hover:text-primary">Simple Interest</h2>
      <p class="mt-1.5 text-[15px] leading-relaxed text-muted">
        Interest on the original principal only — never compounded. Enter a principal, rate, and term in years or months.
      </p>
    <% end %>
  </div>
</section>
