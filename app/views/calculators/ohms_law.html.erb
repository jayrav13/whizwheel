<% content_for :title, "Ohm's Law Calculator — whizwheel" %>

<%#
  Ohm's Law calculator page (spec issue #55, DESIGN.md BLEND). A multi-mode calculator:
  a wrapping pill row picks the input PAIR (the `mode` — one of six unordered pairs of
  V/I/R/P); only that pair's two inputs show, and the page solves the other two. The
  form posts over Turbo and re-renders the #result region in place; it works without JS
  (the server validates the selected mode). Layout per DESIGN.md §3 — an input column +
  a results panel (≈380px 1fr), collapsing to one column on mobile.

  Spacing scale (DESIGN.md §3, "targets not minimums"):
    • mode pills → Grouped-wrapping tier (gap-x-3 gap-y-4)
    • stacked fields → space-y-5
    • major blocks within the card (mode → fields → submit) → mt-8 (Section tier)
    • column gutters / card padding → gap-8 / p-7–p-8 (Layout tier)
%>

<header class="max-w-2xl">
  <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent">Physics</p>
  <h1 class="mt-2 text-4xl font-extrabold tracking-[-0.035em] text-ink">Ohm's Law Calculator</h1>
  <p class="mt-3 text-[15px] leading-relaxed text-muted">
    Voltage, current, resistance, and power are tied together by <span class="font-semibold text-ink">V = I × R</span>
    and <span class="font-semibold text-ink">P = V × I</span>. Pick which two you know, enter them, and the other two
    are computed server-side.
  </p>
</header>

<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[380px_1fr]">
  <%# ── Input column ─────────────────────────────────────────────────────── %>
  <section class="rounded-[18px] border border-border bg-surface p-7 shadow-[0_10px_34px_rgba(150,110,80,0.12)] sm:p-8">
    <%= form_with url: "/calculators/ohms_law", scope: :inputs, method: :post,
          data: { controller: "ohms-law" } do |f| %>

      <%# Mode pills — Grouped-wrapping tier: gap-x-3 gap-y-4 so wrapped rows read as a
          grid of distinct, separately-hittable chips, never a clump (DESIGN.md §3, §4).
          Each pill names the PAIR of quantities the user will supply. %>
      <fieldset>
        <legend class="text-xs font-bold text-label">I know…</legend>
        <div class="mt-3 flex flex-wrap gap-x-3 gap-y-4">
          <% [
               ["vi", "Voltage & Current"],
               ["vr", "Voltage & Resistance"],
               ["vp", "Voltage & Power"],
               ["ir", "Current & Resistance"],
               ["ip", "Current & Power"],
               ["rp", "Resistance & Power"]
             ].each_with_index do |(value, text), i| %>
            <div>
              <%= f.radio_button :mode, value,
                    checked: i.zero?,
                    class: "peer sr-only",
                    data: { ohms_law_target: "modeInput", action: "ohms-law#select" } %>
              <%= f.label :mode, text, value: value,
                    class: "mode-pill",
                    data: { ohms_law_target: "pill", mode: value } %>
            </div>
          <% end %>
        </div>
      </fieldset>

      <%# Per-quantity fields. Each block declares the modes it serves; Stimulus shows
          only the active mode's two blocks and disables the rest so they aren't
          submitted. Stacked tier: space-y-5 down the column (DESIGN.md §3). Each input
          carries its SI-unit affix on the Affix tier (gap-2 — DESIGN.md §3). %>
      <div class="mt-8 space-y-5">
        <%# Voltage — vi, vr, vp %>
        <div data-ohms-law-target="field" data-ohms-law-modes="vi vr vp">
          <%= f.label :voltage, "Voltage (V)", class: "field-label", for: "inputs_voltage" %>
          <div class="mt-1.5 flex items-center gap-2">
            <%= f.number_field :voltage, id: "inputs_voltage", step: "any", inputmode: "decimal",
                  placeholder: "0", class: "field-input" %>
            <span class="text-sm font-bold text-label" aria-hidden="true">V</span>
          </div>
        </div>

        <%# Current — vi, ir, ip %>
        <div data-ohms-law-target="field" data-ohms-law-modes="vi ir ip">
          <%= f.label :current, "Current (I)", class: "field-label", for: "inputs_current" %>
          <div class="mt-1.5 flex items-center gap-2">
            <%= f.number_field :current, id: "inputs_current", step: "any", inputmode: "decimal",
                  placeholder: "0", class: "field-input" %>
            <span class="text-sm font-bold text-label" aria-hidden="true">A</span>
          </div>
        </div>

        <%# Resistance — vr, ir, rp %>
        <div data-ohms-law-target="field" data-ohms-law-modes="vr ir rp">
          <%= f.label :resistance, "Resistance (R)", class: "field-label", for: "inputs_resistance" %>
          <div class="mt-1.5 flex items-center gap-2">
            <%= f.number_field :resistance, id: "inputs_resistance", step: "any", inputmode: "decimal",
                  placeholder: "0", class: "field-input" %>
            <span class="text-sm font-bold text-label" aria-hidden="true">Ω</span>
          </div>
        </div>

        <%# Power — vp, ip, rp %>
        <div data-ohms-law-target="field" data-ohms-law-modes="vp ip rp">
          <%= f.label :power, "Power (P)", class: "field-label", for: "inputs_power" %>
          <div class="mt-1.5 flex items-center gap-2">
            <%= f.number_field :power, id: "inputs_power", step: "any", inputmode: "decimal",
                  placeholder: "0", class: "field-input" %>
            <span class="text-sm font-bold text-label" aria-hidden="true">W</span>
          </div>
        </div>
      </div>

      <%# Submit — Section tier above; primary coral button (DESIGN.md §4). %>
      <%= f.submit "Calculate",
            class: "mt-8 w-full cursor-pointer rounded-[13px] bg-primary px-4 py-3 text-sm font-semibold text-surface shadow-sm transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" %>
    <% end %>
  </section>

  <%# ── Results panel (the Turbo target) ─────────────────────────────────── %>
  <section id="result" aria-live="polite">
    <%= render "calculators/result", calc: nil %>
  </section>
</div>
