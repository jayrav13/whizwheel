<%# The contents of the #result region — one partial for every state so the page's
    initial render and the Turbo Stream replacement share identical markup (DESIGN.md
    §4 Hero-result / Validation errors). Pass `calc:` (a Calculators::* instance) or
    nil for the pristine empty state.

    The success state dispatches by calculator: Percentage gets its bespoke hero
    (mode caption + detail sentence); BMI gets a hero number + category badge + the WHO
    classification scale; any other calculator falls back to a generic key/value render
    so this partial stays honest for the dynamic controller (which renders it for every
    slug). The empty + error states are calculator-agnostic. %>
<% if calc.nil? %>
  <div class="flex min-h-[180px] flex-col items-center justify-center rounded-[18px] border border-dashed border-border-input bg-surface/60 px-6 py-12 text-center">
    <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-faint">Result</p>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">Choose a mode, enter your numbers, and your answer appears here.</p>
  </div>

<% elsif calc.errors.any? %>
  <div role="alert" class="rounded-[18px] border border-primary/40 bg-primary/10 p-6">
    <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-primary">Check your input</p>
    <ul class="mt-3 list-disc space-y-1.5 pl-5 text-[15px] font-semibold text-primary marker:text-primary/60">
      <% calculator_error_messages(calc).each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>

<% elsif calc.is_a?(Calculators::Percentage) %>
  <%= render "calculators/results/percentage", calc: calc %>

<% elsif calc.is_a?(Calculators::OhmsLaw) %>
  <%= render "calculators/results/ohms_law", calc: calc %>

<% elsif calc.is_a?(Calculators::Bmi) %>
  <%= render "calculators/results/bmi", calc: calc %>

<% elsif calc.is_a?(Calculators::Amortization) %>
  <%= render "calculators/results/amortization", calc: calc %>

<% else %>
  <%= render "calculators/results/generic", calc: calc %>
<% end %>
