<%# Pythagorean Theorem result (spec issue #253, DESIGN.md §4 Hero-result + Stat grid + the
    visualisation vocabulary, extended to a static labeled SVG diagram). The headline answer
    is the solved missing side; below it a clean SVG figure of the solved triangle (scaled to
    the real side ratios, sides labeled) gives the geometry at a glance, and a stat grid
    carries all three sides — the solved one lifted to accent green and tagged "Solved", the
    two given sides tagged "Given" (the non-colour state cue, DESIGN.md §6). The SVG is a
    visual ENHANCEMENT: the stat grid is the complete, no-JS data fallback (DESIGN.md §4 — a
    visual never gates access to the numbers). `calc:` is a valid Calculators::PythagoreanTheorem. %>
<% result = calc.result %>
<% points = pythagorean_theorem_points(result) %>
<% solved = pythagorean_theorem_solved_key(result[:mode]) %>
<div class="overflow-hidden rounded-[18px] border border-border bg-surface shadow-[0_10px_34px_rgba(150,110,80,0.12)]">
  <div class="flex gap-5 p-7">
    <span class="w-[5px] shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
    <div class="min-w-0 flex-1">
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent">
        Solved <%= solved == :b ? "leg b" : "hypotenuse c" %>
      </p>

      <%# Hero answer — the solved missing side, big tabular-nums (DESIGN.md §2 Numerals). %>
      <p class="mt-2 flex items-baseline gap-2">
        <span class="text-sm font-bold text-label"><%= solved == :b ? "b" : "c" %> =</span>
        <span class="text-[54px] font-extrabold leading-none tracking-[-0.04em] tabular-nums text-ink">
          <%= pythagorean_theorem_value(result[solved]) %>
        </span>
      </p>

      <%# The substituted equation — raw echoed quantitative data quoted back to the user, so
          a monospace <code> per DESIGN.md §2 (not the formatted hero/stat figures, which stay
          grotesk tabular-nums). Shows the theorem with this run's numbers. %>
      <p class="mt-3">
        <code class="font-mono text-xs text-muted">
          <% if result[:mode] == "leg" %>
            b = √(c² − a²) = √(<%= pythagorean_theorem_value(result[:c]) %>² − <%= pythagorean_theorem_value(result[:a]) %>²) = <%= pythagorean_theorem_value(result[:b]) %>
          <% else %>
            c = √(a² + b²) = √(<%= pythagorean_theorem_value(result[:a]) %>² + <%= pythagorean_theorem_value(result[:b]) %>²) = <%= pythagorean_theorem_value(result[:c]) %>
          <% end %>
        </code>
      </p>

      <%# Figure. The SVG draws the solved right triangle to scale — right angle at the
          bottom-left, leg a up the left, leg b along the bottom, hypotenuse c across. Sides
          are labeled so the picture reads on its own; it has role="img" + a descriptive
          title/aria-label for assistive tech (the figure conveys shape, the grid below
          conveys every exact value). Tokens only — fills/strokes use the @theme colours via
          Tailwind utilities on the SVG elements. %>
      <figure class="mt-5 rounded-[13px] border border-border bg-bg/60 p-4">
        <svg viewBox="0 0 <%= points[:width] %> <%= points[:height] %>"
             class="mx-auto block h-auto w-full max-w-[300px]"
             role="img"
             aria-label="A right triangle with legs a and b and hypotenuse c, drawn to scale.">
          <title>Solved right triangle, drawn to scale</title>
          <%# The triangle body — accent-tinted fill, ink stroke. %>
          <polygon points="<%= pythagorean_theorem_polygon(points) %>"
                   class="fill-accent/10 stroke-ink" stroke-width="2"
                   stroke-linejoin="round" />
          <%# Right-angle marker — a small square at the right-angle vertex (bottom-left). %>
          <% rx, ry = points[:right] %>
          <rect x="<%= rx %>" y="<%= ry - 16 %>" width="16" height="16"
                class="fill-none stroke-ink" stroke-width="1.5" />
          <%# Side labels (symbol + value), each off its edge midpoint. The SOLVED side is
              accent green, the given sides ink — matching the grid's state colours. %>
          <% [
               [points[:mid_a], "a", result[:a], "end",    :a],  # left of the vertical leg → grow left
               [points[:mid_b], "b", result[:b], "middle", :b],  # below the horizontal leg
               [points[:mid_c], "c", result[:c], "start",  :c]   # over the hypotenuse → grow right
             ].each do |(lx, ly), sym, val, anchor, key| %>
            <text x="<%= lx %>" y="<%= ly %>"
                  text-anchor="<%= anchor %>" dominant-baseline="middle"
                  class="<%= key == solved ? "fill-accent" : "fill-ink" %> tabular-nums [font-size:11px] [font-weight:700]">
              <%= sym %> = <%= pythagorean_theorem_value(val) %>
            </text>
          <% end %>
        </svg>
      </figure>

      <%# All three sides — the shared responsive stat grid (DESIGN.md §4 "Stat grid", issue
          #143): `.stat-grid` sizes each card to a min and lets the grid flow. The `--wide`
          (13rem) track is used because the realistic worst-case figures are LONG: large legs
          drive the hypotenuse into delimited high-magnitude numbers that wrap mid-number on
          the default 9.5rem track in the narrow result panel (DESIGN.md §4: single-line is
          preferred for long figures; the never-clip overflow-wrap net on `.stat-card dd` is
          the wrapping floor below that). Each card is a `.stat-card`; the SOLVED side is
          lifted to accent green and tagged "Solved", the two given sides "Given" — the state
          reads without leaning on colour (DESIGN.md §6). Fixed read order: a, b, c. %>
      <dl class="mt-5 stat-grid stat-grid--wide">
        <% pythagorean_theorem_figures.each do |fig| %>
          <% is_solved = fig[:key] == solved %>
          <div class="stat-card">
            <dt class="flex items-center justify-between gap-2 text-xs font-bold text-label">
              <span class="flex items-center gap-1.5">
                <span><%= fig[:label] %></span>
                <span class="font-semibold text-faint">(<%= fig[:symbol] %>)</span>
              </span>
              <span class="shrink-0 rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.08em] <%= is_solved ? "bg-accent/10 text-accent" : "bg-bg text-faint" %>">
                <%= is_solved ? "Solved" : "Given" %>
              </span>
            </dt>
            <dd class="mt-2">
              <span class="text-2xl font-extrabold tracking-[-0.03em] tabular-nums <%= is_solved ? "text-accent" : "text-ink" %>">
                <%= pythagorean_theorem_value(result[fig[:key]]) %>
              </span>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</div>
