<%# Date result (spec issue #195, DESIGN.md §4 Hero-result + Stat grid). The calculator has
    two modes and the envelope's `mode` key (§4) selects which result to render:

      • difference   — a surface hero card (5px coral left rule) holding the calendar-aware
                       Y/M/D breakdown as the headline, with the total-day count, the
                       weeks-and-days view, and the day/week totals in the shared stat grid.
      • add_subtract — a hero card holding the resulting date as the headline, echoing the
                       start date and operation that produced it.

    `calc:` is a valid Calculators::Date. Both branches share the same hero shell so the page
    reads as one product across modes. %>
<% result = calc.result %>
<div class="overflow-hidden rounded-[18px] border border-border bg-surface shadow-[0_10px_34px_rgba(150,110,80,0.12)]">
  <div class="flex gap-5 p-7">
    <span class="w-[5px] shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
    <div class="min-w-0 flex-1">

      <% if result[:mode] == "difference" %>
        <%# ── Difference result ─────────────────────────────────────────── %>
        <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent">Time between</p>

        <%# The calendar breakdown — the headline. Three big figures (Y / M / D), each with
            its unit beneath, on the Affix/Grouped tiers so they read as one answer. The
            tabular-nums keeps the numerals aligned. %>
        <dl class="mt-3 flex flex-wrap items-baseline gap-x-6 gap-y-3">
          <% [ [ :years, "years" ], [ :months, "months" ], [ :days, "days" ] ].each do |key, unit| %>
            <div class="flex items-baseline gap-1.5">
              <dt class="sr-only"><%= unit %></dt>
              <dd class="text-5xl font-extrabold tracking-[-0.04em] tabular-nums text-ink"><%= integer_display(result[key]) %></dd>
              <span class="text-sm font-semibold text-label" aria-hidden="true"><%= unit %></span>
            </div>
          <% end %>
        </dl>

        <%# A plain-language echo of the same breakdown (zero units dropped) so the answer
            reads as a sentence, plus the weeks-and-days view. %>
        <p class="mt-3 text-[15px] leading-relaxed text-muted">
          <%= date_breakdown_phrase(result) %> · <%= date_weeks_phrase(result) %>
        </p>

        <%# Day / week totals — the same span as plain counts in the shared responsive stat
            grid (DESIGN.md §4 "Stat grid", issue #143). `total_days` is a plain unit-less
            number that is unbounded above (a multi-century span reaches 6+ digits), so the
            grid uses `.stat-grid--wide` to hold the worst case on one line; the `.stat-card`
            never-clip safety net (overflow-wrap on the value `<dd>`) is the floor below that
            (DESIGN.md §4: stats must NEVER clip). %>
        <dl class="mt-6 stat-grid stat-grid--wide">
          <% [
               [ "Total days",  result[:total_days] ],
               [ "Total weeks", result[:total_weeks] ],
               [ "Remaining days", result[:remainder_days] ]
             ].each do |label, value| %>
            <div class="stat-card">
              <dt class="text-[11px] font-bold uppercase tracking-[0.12em] text-faint"><%= label %></dt>
              <dd class="mt-1.5 break-words text-2xl font-extrabold tracking-[-0.02em] tabular-nums text-ink"><%= integer_display(value) %></dd>
            </div>
          <% end %>
        </dl>

      <% else %>
        <%# ── Add / subtract result ─────────────────────────────────────── %>
        <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent">Resulting date</p>

        <%# The resulting date — the headline answer. Big tabular-nums ISO form for precision,
            with the long human date beneath as the plain-language echo. %>
        <p class="mt-3 text-5xl font-extrabold tracking-[-0.04em] tabular-nums text-ink"><%= result[:result_date] %></p>
        <p class="mt-3 text-[15px] leading-relaxed text-muted"><%= date_long_format(result[:result_date]) %></p>

        <%# Echo the inputs that produced it — the start date and the operation — in the
            shared stat grid (default track: short, low-magnitude values), so the answer reads
            in the context of its inputs. %>
        <dl class="mt-6 stat-grid">
          <div class="stat-card">
            <dt class="text-[11px] font-bold uppercase tracking-[0.12em] text-faint">Start date</dt>
            <dd class="mt-1.5 break-words text-lg font-bold tabular-nums text-ink"><%= result[:start_date] %></dd>
          </div>
          <div class="stat-card">
            <dt class="text-[11px] font-bold uppercase tracking-[0.12em] text-faint">Operation</dt>
            <dd class="mt-1.5 break-words text-lg font-bold capitalize text-ink"><%= result[:operation] %></dd>
          </div>
        </dl>
      <% end %>

    </div>
  </div>
</div>
