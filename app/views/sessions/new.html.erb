<div class="mx-auto max-w-md">
  <section class="rounded-[18px] border border-border bg-surface p-8 shadow-[0_10px_34px_rgba(150,110,80,0.12)]">
    <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent">Accounts</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-[-0.035em] text-ink">Sign in</h1>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">
      Enter your username and password to access your history and stats.
    </p>

    <%= form_with url: session_path, method: :post, class: "mt-6 space-y-5" do |f| %>
      <div>
        <%= f.label :username, "Username", class: "block text-xs font-bold text-label" %>
        <%= f.text_field :username, autocomplete: "username",
              class: "mt-1.5 block w-full rounded-[11px] border border-border-input bg-surface px-3.5 py-2.5 text-ink placeholder:text-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/40" %>
      </div>

      <div>
        <%= f.label :password, "Password", class: "block text-xs font-bold text-label" %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "mt-1.5 block w-full rounded-[11px] border border-border-input bg-surface px-3.5 py-2.5 text-ink placeholder:text-faint focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/40" %>
      </div>

      <%= f.submit "Sign in",
            class: "w-full cursor-pointer rounded-[13px] bg-primary px-4 py-2.5 text-sm font-semibold text-surface shadow-sm transition-opacity hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" %>
    <% end %>
  </section>
</div>
