# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Raw conversation transcripts snapshotted by the historian (replayable record).
# Gitignored for now; the synthesized narrative lives in JOURNEY.md.
/conversations/

# SimpleCov coverage output (generated when tests run).
/coverage/


# Superpowers brainstorming companion (local mockups)
.superpowers/

# Git worktrees for isolated/concurrent sessions and the fan-out sweep (see CLAUDE.md → Worktrees).
.claude/worktrees/

/app/assets/builds/*
!/app/assets/builds/.keep

# Generated GitHub Pages output (bin/build-agents-site). Regenerated from
# .claude/agents/*.md on every deploy, so it is never committed — the site is
# derived, not stored (lockstep by construction). See .github/workflows/agents-pages.yml.
/_site/
